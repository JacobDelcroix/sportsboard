{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@jacobdelcroix/sportsboard": ["./src/index.ts"],
      "@jacobdelcroix/sportsboard/core": ["./src/core/index.ts"],
      "@jacobdelcroix/sportsboard/viewer": ["./src/viewer/index.ts"],
      "@jacobdelcroix/sportsboard/editor": ["./src/editor/index.ts"],
      "@jacobdelcroix/sportsboard/element": ["./src/element/index.ts"],
      "@jacobdelcroix/sportsboard/editor/element": ["./src/element/editor-entry.ts"],
      "@jacobdelcroix/sportsboard/viewer/element": ["./src/element/viewer-entry.ts"],
      "@jacobdelcroix/sportsboard/basketball": ["./src/sports/basketball/index.ts"],
      "@jacobdelcroix/sportsboard/basketball/viewer": ["./src/sports/basketball/viewer-entry.ts"],
      "@jacobdelcroix/sportsboard/basketball/editor": ["./src/sports/basketball/editor-entry.ts"],
      "@jacobdelcroix/sportsboard/football": ["./src/sports/football/index.ts"],
      "@jacobdelcroix/sportsboard/football/viewer": ["./src/sports/football/viewer-entry.ts"],
      "@jacobdelcroix/sportsboard/football/editor": ["./src/sports/football/editor-entry.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.json", "tests/**/*.ts", "tests/**/*.json", "examples/vanilla/src/**/*.ts", "examples/vanilla/vite.config.ts"]
}
